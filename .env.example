# Ucuz Bilet Bul - Çevre Değişkenleri

# Sunucu Ayarları
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Zamanlayıcı (Cron) Periyodu (Saat cinsinden: 1-6)
PRICE_CHECK_INTERVAL_HOURS=2

# Resend API Key (HTML E-Posta Bildirimi için - https://resend.com)
RESEND_API_KEY=re_1234567890abcdef

# Telegram Bot API (Anlık Telegram Bildirimleri için - @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Twilio API (WhatsApp Bildirimleri için - Opsiyonel)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=whatsapp:+14155238886
